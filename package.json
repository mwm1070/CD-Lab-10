{
  "name": "plymouth-weather-scene",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A live Plymouth, NH weather app whose hero image is re-imagined by an LLM to match the time of day, season, and forecast.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "fetch:reference": "node scripts/fetch-reference.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "suncalc": "^2.1.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
